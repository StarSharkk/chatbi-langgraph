# 复制成 .env 后自己填写。.env 已在 .gitignore 里，不会被提交
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-flash

# ChatBI 专用的只读 MySQL 账号（不要用 root）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=chatbi_ro
MYSQL_PASSWORD=
MYSQL_DB=taobao
# 连云数据库（如 TiDB Cloud）时改成 true，启用加密连接
MYSQL_SSL=false

# 公开部署时设置：访问密码、每个会话最多提问次数
APP_PASSWORD=
MAX_QUESTIONS_PER_SESSION=20
